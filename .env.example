# Copy this file to .env.local and fill in the key. Never commit .env.local.

# Server-side only. Without a key the app runs on a clearly labeled offline mock model.
GEMINI_API_KEY=

# `npm run report` checks this name and suggests a working one if it fails.
GEMINI_MODEL=gemini-3.5-flash-lite

# How many model calls the X-ray may run at the same time. Raise only after running `npm run report`.
MAX_PARALLEL=5

# Runs per ablated chunk (1 to 3). Start at 1 for speed.
XRAY_RUNS=1
