# Copy this file to .env.local and fill in the key. Never commit .env.local.

# Server-side only. Never prefix with NEXT_PUBLIC_.
# Without a key the app runs on a clearly labeled offline mock model.
OPENAI_API_KEY=

# Low-cost, fast model. `npm run report` checks it and suggests a working one if it fails.
OPENAI_MODEL=gpt-6-luna

# How many model calls the X-ray may run at the same time. Raise only after running `npm run report`.
MAX_PARALLEL=5

# Runs per ablated chunk (1 to 3). Start at 1 for speed.
XRAY_RUNS=1
